# ---------- database ----------
DATABASE_URL=postgresql+psycopg2://fde:fde_pass@localhost:5432/ehrdb
EHR_TABLE=patient_encounters

# ---------- embeddings ----------
# hash = offline lexical demo | st = semantic biomedical model (pip install -r requirements-ml.txt)
EMBED_BACKEND=hash
EMBED_MODEL=NeuML/bioclinical-modernbert-embeddings
EMBED_DIM=768

# ---------- redaction ----------
SPACY_MODEL=en_core_web_lg
REDACT_THRESHOLD=0.4
HOSPITAL_NAMES=St. Mary's General Hospital,Riverside Medical Center

# ---------- LLM ----------
# mock = no key, extractive answers | openai = any OpenAI-compatible endpoint
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- misc ----------
TOP_K=8
USE_NEMO=false
API_URL=http://localhost:8000
# If set, the API requires header X-API-Key (UI sends it automatically)
API_KEY=
